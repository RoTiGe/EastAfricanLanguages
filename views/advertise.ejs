<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Post an Advertisement</title>
    <link href="/public/css/select2.min.css" rel="stylesheet" />
    <style>
        .ad-form-container { max-width: 500px; margin: 40px auto; padding: 30px; border: 1px solid #ccc; border-radius: 8px; background: #fafafa; }
        .ad-form-container h2 { text-align: center; }
        .ad-form-container label { display: block; margin-top: 15px; }
        .ad-form-container input, .ad-form-container textarea, .ad-form-container select { width: 100%; padding: 8px; margin-top: 5px; }
        .ad-form-container button { margin-top: 20px; width: 100%; }
        .ad-form-container .note { font-size: 0.95em; color: #666; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="ad-form-container">
        <h2>Post an Advertisement</h2>
        <form id="adForm" action="/advertise" method="POST" enctype="multipart/form-data">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required>

            <label for="language">Language</label>
            <select id="language" name="language" required>
                <% LANGUAGES.forEach(function(lang) { %>
                    <option value="<%= lang %>"><%= LANGUAGE_NAMES[lang] || lang %></option>
                <% }); %>
            </select>

            <label for="title">Ad Title</label>
            <input type="text" id="title" name="title" maxlength="100" required>

            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4" maxlength="1000" required></textarea>

            <label for="image">Image/Poster (optional)</label>
            <input type="file" id="image" name="image" accept="image/*">

            <div class="note">You can only advertise in one language at a time. Your ad will be visible to users who select this language as their native or learning language. You must verify your email before your ad is published. Ads expire after 2 weeks unless renewed.</div>

            <button type="submit">Submit Advertisement</button>
        </form>
        <div id="formMessage"></div>
    </div>
    <script src="/public/js/jquery.min.js"></script>
    <script src="/public/js/select2.min.js"></script>
    <script>
        $(function() {
            $('#language').select2();
        });
    </script>
</body>
</html>
