<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Sound Training</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .advert-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .advert-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .advert-image {
            height: 200px;
            object-fit: cover;
        }
        .language-badge {
            position: absolute;
            top: 10px;
            right: 10px;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <header class="text-white py-4 position-relative">
            <div class="container">
                <a href="/" class="btn btn-light position-absolute top-0 start-0 m-3">
                    <i class="bi bi-arrow-left me-2"></i>Back to Home
                </a>
                <h1 class="text-center display-5 fw-bold">
                    <i class="bi bi-megaphone me-2"></i>Community Adverts
                </h1>
                <p class="text-center lead">Language learning services & resources from our community</p>
            </div>
        </header>

        <main class="container my-5">
            <!-- Filter & Submit Section -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <label for="languageFilter" class="form-label fw-bold">Filter by Language:</label>
                    <select id="languageFilter" class="form-select">
                        <option value="">All Languages</option>
                        <% Object.keys(languageNames).forEach(lang => { %>
                            <option value="<%= lang %>"><%= languageNames[lang] %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button class="btn btn-primary btn-lg w-100" data-bs-toggle="modal" data-bs-target="#submitModal">
                        <i class="bi bi-plus-circle me-2"></i>Submit Your Advert
                    </button>
                </div>
            </div>

            <!-- Adverts Grid -->
            <div id="advertsGrid" class="row g-4">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </main>

        <!-- Submit Modal -->
        <div class="modal fade" id="submitModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-megaphone me-2"></i>Submit an Advert</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="advertForm" enctype="multipart/form-data">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email *</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                                <small class="text-muted">Used for verification - not displayed publicly</small>
                            </div>
                            <div class="mb-3">
                                <label for="language" class="form-label">Target Language *</label>
                                <select class="form-select" id="language" name="language" required>
                                    <option value="">Select a language...</option>
                                    <% Object.keys(languageNames).forEach(lang => { %>
                                        <option value="<%= lang %>"><%= languageNames[lang] %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="title" class="form-label">Title *</label>
                                <input type="text" class="form-control" id="title" name="title" maxlength="100" required>
                            </div>
                            <div class="mb-3">
                                <label for="description" class="form-label">Description *</label>
                                <textarea class="form-control" id="description" name="description" rows="4" maxlength="500" required></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="image" class="form-label">Image (optional)</label>
                                <input type="file" class="form-control" id="image" name="image" accept="image/*">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-2"></i>Submit for Review
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <footer class="bg-dark text-white text-center py-4 mt-5">
            <div class="container">
                <p class="mb-0">© 2026 Sound Training - Community Adverts</p>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const languageNames = <%- JSON.stringify(languageNames) %>;
        
        async function loadAdverts(language = '') {
            const grid = document.getElementById('advertsGrid');
            grid.innerHTML = '<div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const url = language ? `/api/adverts?language=${language}` : '/api/adverts';
                const response = await fetch(url);
                const adverts = await response.json();
                
                if (adverts.length === 0) {
                    grid.innerHTML = `
                        <div class="col-12 text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted"></i>
                            <p class="text-muted mt-3">No adverts found. Be the first to submit one!</p>
                        </div>`;
                    return;
                }
                
                grid.innerHTML = adverts.map(ad => `
                    <div class="col-md-6 col-lg-4">
                        <div class="card advert-card h-100 position-relative">
                            ${ad.imagePath ? `<img src="${ad.imagePath}" class="card-img-top advert-image" alt="${ad.title}">` : ''}
                            <span class="badge bg-primary language-badge">${languageNames[ad.language] || ad.language}</span>
                            <div class="card-body">
                                <h5 class="card-title">${ad.title}</h5>
                                <p class="card-text">${ad.description}</p>
                            </div>
                            <div class="card-footer text-muted small">
                                Posted ${new Date(ad.createdAt).toLocaleDateString()}
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch (error) {
                grid.innerHTML = '<div class="col-12 text-center py-5 text-danger">Failed to load adverts</div>';
            }
        }

        // Filter by language
        document.getElementById('languageFilter').addEventListener('change', (e) => {
            loadAdverts(e.target.value);
        });

        // Submit form
        document.getElementById('advertForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            try {
                const response = await fetch('/api/adverts', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (response.ok) {
                    alert('Advert submitted! Check your email for verification.');
                    form.reset();
                    bootstrap.Modal.getInstance(document.getElementById('submitModal')).hide();
                    loadAdverts();
                } else {
                    alert(result.error || 'Failed to submit advert');
                }
            } catch (error) {
                alert('Failed to submit advert');
            }
        });

        // Load adverts on page load
        loadAdverts();
    </script>
</body>
</html>

