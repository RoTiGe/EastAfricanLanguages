<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Language Bridge</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .verse-card { transition: all 0.3s ease; border-left: 4px solid #6f42c1; }
        .verse-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.15); }
        .religion-badge { font-size: 0.75rem; }
        .language-pill { font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
        .language-pill:hover { transform: scale(1.05); }
        .language-pill.active { background-color: #6f42c1 !important; color: white !important; }
        .translation-text { font-size: 1.1rem; line-height: 1.6; }
        .scripture-ref { font-style: italic; color: #6c757d; }
        .nav-tabs .nav-link { color: #495057; }
        .nav-tabs .nav-link.active { color: #6f42c1; border-color: #6f42c1 #6f42c1 #fff; font-weight: 600; }
        .hero-section { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        /* Religion Map Styles */
        .religion-map { position: relative; }
        .religion-btn {
            transition: all 0.3s ease;
            font-weight: 500;
            border-radius: 25px !important;
        }
        .religion-btn:hover {
            transform: scale(1.08) translateY(-3px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.25) !important;
        }
        .religion-btn .badge {
            font-size: 0.65rem;
            padding: 3px 6px;
        }
        @media (max-width: 768px) {
            .religion-map { min-height: 800px !important; }
            .religion-btn { font-size: 0.75rem !important; padding: 0.4rem 0.6rem !important; }
            .religion-btn .badge { display: none; }
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <!-- Header -->
        <header class="hero-section text-white py-5">
            <div class="container">
                <a href="/" class="btn btn-light position-absolute top-0 start-0 m-3">
                    <i class="bi bi-arrow-left me-2"></i>Back to Home
                </a>
                <div class="text-center">
                    <h1 class="display-4 fw-bold mb-3">
                        <i class="bi bi-heart-fill me-3"></i>Close to Heart
                    </h1>
                    <p class="lead mb-0">Sacred wisdom from world traditions, in your language</p>
                </div>
            </div>
        </header>

        <main class="container my-5">
            <!-- World Religions Distribution Map -->
            <section class="mb-5">
                <h2 class="text-center mb-4 h3"><i class="bi bi-globe2 me-2"></i>World Religions Distribution</h2>
                <p class="text-center text-muted mb-4">Click any religion to explore its wisdom teachings</p>
                <div class="religion-map position-relative mx-auto" style="min-height: 480px; max-width: 1100px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 20px; border: 2px solid #dee2e6;">

                    <!-- Christianity - Americas, Europe, Africa, Oceania -->
                    <div class="position-absolute" style="top: 15%; left: 8%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Christianity')" style="background: linear-gradient(135deg, #6f42c1, #8b5cf6); color: white; border: none;">
                            <i class="bi bi-cross me-2"></i>Christianity
                            <span class="badge bg-light text-dark ms-2">2.4B</span>
                        </a>
                    </div>

                    <!-- Islam - Middle East, North Africa, Indonesia, Central Asia -->
                    <div class="position-absolute" style="top: 28%; left: 52%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Islam')" style="background: linear-gradient(135deg, #198754, #20c997); color: white; border: none;">
                            <i class="bi bi-moon-stars me-2"></i>Islam
                            <span class="badge bg-light text-dark ms-2">1.9B</span>
                        </a>
                    </div>

                    <!-- Hinduism - India, Nepal -->
                    <div class="position-absolute" style="top: 40%; left: 68%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Hinduism')" style="background: linear-gradient(135deg, #fd7e14, #ffc107); color: white; border: none;">
                            <i class="bi bi-flower3 me-2"></i>Hinduism
                            <span class="badge bg-light text-dark ms-2">1.2B</span>
                        </a>
                    </div>

                    <!-- Buddhism - East/Southeast Asia -->
                    <div class="position-absolute" style="top: 22%; left: 78%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Buddhism')" style="background: linear-gradient(135deg, #ffc107, #ffdb58); color: #333; border: none;">
                            <i class="bi bi-yin-yang me-2"></i>Buddhism
                            <span class="badge bg-dark text-light ms-2">500M</span>
                        </a>
                    </div>

                    <!-- Sikhism - Punjab, India -->
                    <div class="position-absolute" style="top: 35%; left: 62%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Sikhism')" style="background: linear-gradient(135deg, #dc3545, #ff6b6b); color: white; border: none;">
                            <i class="bi bi-shield-fill me-2"></i>Sikhism
                            <span class="badge bg-light text-dark ms-2">30M</span>
                        </a>
                    </div>

                    <!-- Judaism - Israel, Americas -->
                    <div class="position-absolute" style="top: 25%; left: 48%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Judaism')" style="background: linear-gradient(135deg, #0d6efd, #6ea8fe); color: white; border: none;">
                            <i class="bi bi-star-of-david me-2"></i>Judaism
                            <span class="badge bg-light text-dark ms-2">15M</span>
                        </a>
                    </div>

                    <!-- Daoism - China -->
                    <div class="position-absolute" style="top: 18%; left: 82%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Daoism')" style="background: linear-gradient(135deg, #6c757d, #adb5bd); color: white; border: none;">
                            <i class="bi bi-water me-2"></i>Daoism
                            <span class="badge bg-light text-dark ms-2">12M</span>
                        </a>
                    </div>

                    <!-- Jainism - India -->
                    <div class="position-absolute" style="top: 48%; left: 72%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Jainism')" style="background: linear-gradient(135deg, #20c997, #40e0d0); color: white; border: none;">
                            <i class="bi bi-hand-index me-2"></i>Jainism
                            <span class="badge bg-light text-dark ms-2">5M</span>
                        </a>
                    </div>

                    <!-- African Traditional - Sub-Saharan Africa -->
                    <div class="position-absolute" style="top: 55%; left: 45%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('African Traditional Religions')" style="background: linear-gradient(135deg, #e83e8c, #ff69b4); color: white; border: none;">
                            <i class="bi bi-tree-fill me-2"></i>African Traditional
                            <span class="badge bg-light text-dark ms-2">100M</span>
                        </a>
                    </div>

                    <!-- Oromo Waaqeffannaa - Ethiopia/Kenya -->
                    <div class="position-absolute" style="top: 48%; left: 55%;">
                        <a href="#" class="btn btn-lg shadow-sm religion-btn" onclick="showReligion('Oromo Waaqeffannaa')" style="background: linear-gradient(135deg, #17a2b8, #5bc0de); color: white; border: none;">
                            <i class="bi bi-sun-fill me-2"></i>Waaqeffannaa
                            <span class="badge bg-light text-dark ms-2">4M</span>
                        </a>
                    </div>

                    <!-- Map Legend -->
                    <div class="position-absolute bg-white rounded shadow-sm p-3" style="bottom: 10px; right: 10px; font-size: 0.85rem;">
                        <strong class="d-block mb-2"><i class="bi bi-info-circle me-1"></i>Followers (est.)</strong>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-secondary">B = Billion</span>
                            <span class="badge bg-secondary">M = Million</span>
                        </div>
                    </div>

                    <!-- Geographic Regions Labels -->
                    <div class="position-absolute text-muted" style="top: 5%; left: 5%; font-size: 0.7rem; opacity: 0.6;">
                        <i class="bi bi-geo-alt"></i> Americas
                    </div>
                    <div class="position-absolute text-muted" style="top: 5%; left: 40%; font-size: 0.7rem; opacity: 0.6;">
                        <i class="bi bi-geo-alt"></i> Europe
                    </div>
                    <div class="position-absolute text-muted" style="top: 20%; left: 45%; font-size: 0.7rem; opacity: 0.6;">
                        <i class="bi bi-geo-alt"></i> Middle East
                    </div>
                    <div class="position-absolute text-muted" style="top: 45%; left: 38%; font-size: 0.7rem; opacity: 0.6;">
                        <i class="bi bi-geo-alt"></i> Africa
                    </div>
                    <div class="position-absolute text-muted" style="top: 35%; left: 75%; font-size: 0.7rem; opacity: 0.6;">
                        <i class="bi bi-geo-alt"></i> South Asia
                    </div>
                    <div class="position-absolute text-muted" style="top: 12%; left: 85%; font-size: 0.7rem; opacity: 0.6;">
                        <i class="bi bi-geo-alt"></i> East Asia
                    </div>
                </div>
            </section>

            <!-- Dual Language Selection -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="bi bi-translate me-2"></i>Select Languages</h5>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <%- include('partials/language-dropdown', {
                                id: 'nativeLanguageSelect',
                                name: 'nativeLanguage',
                                selected: nativeLanguage || 'english',
                                languages: languages,
                                languageNames: languageNames,
                                label: '<i class="bi bi-person-fill me-2"></i>Your Native Language',
                                extraClass: '',
                                ariaLabel: 'Select your native language'
                            }) %>
                        </div>
                        <div class="col-12 col-md-6">
                            <%- include('partials/language-dropdown', {
                                id: 'targetLanguageSelect',
                                name: 'targetLanguage',
                                selected: targetLanguage || 'amharic',
                                languages: languages,
                                languageNames: languageNames,
                                label: '<i class="bi bi-person-badge-fill me-2"></i>Target Language to Learn',
                                extraClass: '',
                                ariaLabel: 'Select target language to learn'
                            }) %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Tabs -->
            <ul class="nav nav-tabs nav-justified mb-4 flex-wrap" id="contentTabs" role="tablist">
                <% religiousContent.forEach((item, index) => { %>
                <li class="nav-item" role="presentation">
                    <button class="nav-link <%= index === 0 ? 'active' : '' %>"
                            id="<%= item.id %>-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#<%= item.id %>"
                            type="button"
                            style="<%= index === 0 ? '' : '' %>">
                        <i class="<%= item.icon %> me-2" style="color: <%= item.color %>;"></i>
                        <span class="tab-title"><%= item.data.metadata?.title?.[nativeLanguage] || item.data.metadata?.title?.english || item.id %></span>
                    </button>
                </li>
                <% }); %>
            </ul>

            <div class="tab-content" id="contentTabsContent">
                <% religiousContent.forEach((item, index) => { %>
                <div class="tab-pane fade <%= index === 0 ? 'show active' : '' %>" id="<%= item.id %>" role="tabpanel">
                    <div class="alert alert-light border mb-4" style="border-left: 4px solid <%= item.color %> !important;">
                        <h5 class="mb-2"><i class="bi bi-info-circle me-2"></i><span class="content-title" data-id="<%= item.id %>"><%= item.data.metadata?.title?.[nativeLanguage] || item.data.metadata?.title?.english || 'Content' %></span></h5>
                        <p class="mb-0 content-description" data-id="<%= item.id %>"><%= item.data.metadata?.description?.[nativeLanguage] || item.data.metadata?.description?.english || '' %></p>
                    </div>
                    <div class="row g-4" id="<%= item.id %>Container">
                        <!-- Populated by JavaScript -->
                    </div>
                </div>
                <% }); %>
            </div>
        </main>

        <footer class="bg-dark text-white text-center py-4 mt-5">
            <div class="container">
                <p class="mb-0">© 2026 Language Bridge - Close to Heart</p>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Dynamic religious content from server
        const religiousContent = <%- JSON.stringify(religiousContent) %>;
        const languageNames = <%- JSON.stringify(languageNames) %>;
        let nativeLanguage = '<%= nativeLanguage || "english" %>';
        let targetLanguage = '<%= targetLanguage || "amharic" %>';

        document.addEventListener('DOMContentLoaded', () => {
            // Render all content sections
            religiousContent.forEach(item => renderContent(item));

            // Language change handlers
            document.getElementById('nativeLanguageSelect').addEventListener('change', (e) => {
                nativeLanguage = e.target.value;
                updateTitlesAndDescriptions();
                religiousContent.forEach(item => renderContent(item));
            });
            document.getElementById('targetLanguageSelect').addEventListener('change', (e) => {
                targetLanguage = e.target.value;
                religiousContent.forEach(item => renderContent(item));
            });
        });

        // Update tab titles and descriptions when native language changes
        function updateTitlesAndDescriptions() {
            religiousContent.forEach(item => {
                const title = item.data.metadata?.title?.[nativeLanguage] || item.data.metadata?.title?.english || item.id;
                const desc = item.data.metadata?.description?.[nativeLanguage] || item.data.metadata?.description?.english || '';

                // Update tab title
                const tabTitle = document.querySelector(`#${item.id}-tab .tab-title`);
                if (tabTitle) tabTitle.textContent = title;

                // Update content title and description
                const contentTitle = document.querySelector(`.content-title[data-id="${item.id}"]`);
                if (contentTitle) contentTitle.textContent = title;

                const contentDesc = document.querySelector(`.content-description[data-id="${item.id}"]`);
                if (contentDesc) contentDesc.textContent = desc;
            });
        }

        // Generic content renderer that handles different content structures
        function renderContent(item) {
            const container = document.getElementById(`${item.id}Container`);
            if (!container) return;

            const data = item.data;
            const color = item.color || '#6c757d';

            // Handle content.sections structure (beatitudes, lords_prayer, quran_fatiha)
            if (data.content?.sections) {
                renderSectionsContent(container, data, color);
            }
            // Handle chapters structure (world_wisdom)
            else if (data.chapters) {
                renderChaptersContent(container, data, color);
            }
            else {
                container.innerHTML = '<p class="text-muted">No content data available for this section.</p>';
            }
        }

        // Render content with sections/items structure
        function renderSectionsContent(container, data, color) {
            const allItems = [];
            (data.content?.sections || []).forEach(section => {
                (section.items || []).forEach(item => allItems.push(item));
            });

            if (allItems.length === 0) {
                container.innerHTML = '<p class="text-muted">No content available.</p>';
                return;
            }

            container.innerHTML = allItems.map(item => {
                const nativeText = item.text?.[nativeLanguage] || item.text?.english || 'Translation not available';
                const targetText = item.text?.[targetLanguage] || item.text?.english || 'Translation not available';
                const targetPhonetic = item.phonetic?.[targetLanguage] || '';
                const hasPhonetic = targetPhonetic && targetLanguage !== 'english';
                const reference = item.reference || '';
                const safeTargetText = targetText.replace(/`/g, "\\`").replace(/\$/g, "\\$");

                return `
                    <div class="col-md-6">
                        <div class="card verse-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge text-white" style="background-color: ${color};">${reference}</span>
                                    <button class="btn btn-sm btn-outline-primary" onclick="speakText(\`${safeTargetText}\`, '${targetLanguage}')" title="Listen">
                                        <i class="bi bi-volume-up"></i>
                                    </button>
                                </div>
                                <div class="mb-3 p-2 bg-light rounded">
                                    <small class="text-muted d-block mb-1"><i class="bi bi-translate me-1"></i>Meaning (${languageNames[nativeLanguage] || nativeLanguage}):</small>
                                    <span class="translation-text">${nativeText}</span>
                                </div>
                                <div class="mb-2 p-2 border rounded" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
                                    <small class="text-muted d-block mb-1"><i class="bi bi-type me-1"></i>Native Script (${languageNames[targetLanguage] || targetLanguage}):</small>
                                    <span class="translation-text fs-5" style="font-weight: 500;">${targetText}</span>
                                </div>
                                ${hasPhonetic ? `
                                <div class="p-2 border-start border-3 border-success bg-success bg-opacity-10 rounded-end">
                                    <small class="text-success d-block mb-1"><i class="bi bi-mic me-1"></i>How to Pronounce:</small>
                                    <span class="phonetic-text text-dark" style="font-family: 'Courier New', monospace; letter-spacing: 0.5px;">${targetPhonetic}</span>
                                </div>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Render content with chapters/verses structure
        function renderChaptersContent(container, data, defaultColor) {
            const chapters = data.chapters || [];
            if (chapters.length === 0) {
                container.innerHTML = '<p class="text-muted">No content available.</p>';
                return;
            }

            const colors = { 'Islam': '#198754', 'Hinduism': '#fd7e14', 'Buddhism': '#ffc107', 'Judaism': '#0d6efd',
                'Christianity': '#6f42c1', 'Sikhism': '#dc3545', 'Jainism': '#20c997', 'Daoism': '#6c757d',
                'African Traditional Religions': '#e83e8c', 'Oromo Waaqeffannaa': '#17a2b8' };

            container.innerHTML = chapters.map(ch => {
                const religionName = ch.religion?.[targetLanguage] || ch.religion?.english || 'Unknown';
                const source = ch.source?.[targetLanguage] || ch.source?.english || '';
                const chapterName = ch.chapter_name?.[targetLanguage] || ch.chapter_name?.english || '';
                const colorKey = ch.religion?.english || '';
                const color = colors[colorKey] || defaultColor;

                const versesHtml = (ch.verses || []).map(v => {
                    const nativeText = v.text?.[nativeLanguage] || v.text?.english || 'Translation not available';
                    const targetText = v.text?.[targetLanguage] || v.text?.english || 'Translation not available';
                    const safeTargetText = targetText.replace(/`/g, "\\`").replace(/\$/g, "\\$");
                    return `
                        <div class="mb-3">
                            <div><span class="fw-bold">Your Language:</span> <span class="translation-text">${nativeText}</span></div>
                            <div><span class="fw-bold">Target Language:</span> <span class="translation-text">${targetText}</span>
                                <button class="btn btn-sm btn-outline-primary ms-2" onclick="speakText(\`${safeTargetText}\`, '${targetLanguage}')">
                                    <i class="bi bi-volume-up me-1"></i>Listen
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');

                return `
                    <div class="col-md-6 col-lg-4">
                        <div class="card verse-card h-100" style="border-left-color: ${color};">
                            <div class="card-header bg-transparent">
                                <span class="badge religion-badge" style="background-color: ${color};">${religionName}</span>
                                <small class="text-muted d-block mt-1">${source}</small>
                            </div>
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">${chapterName}</h6>
                                ${versesHtml}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function speakText(text, language) {
            try {
                const response = await fetch('/api/speak', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ text, language })
                });
                if (response.ok) {
                    const data = await response.json();
                    const audio = new Audio(data.audioUrl);
                    audio.play();
                }
            } catch (error) { console.error('Speech error:', error); }
        }

        // Religion Map - Show selected religion's wisdom (works with dynamic tabs)
        function showReligion(religionName) {
            // Find the world_wisdom tab (or first tab with chapters/religions)
            const wisdomItem = religiousContent.find(item => item.data.chapters);
            if (!wisdomItem) return;

            const wisdomTab = document.getElementById(`${wisdomItem.id}-tab`);
            const wisdomPane = document.getElementById(wisdomItem.id);

            // Deactivate all tabs and panes
            document.querySelectorAll('#contentTabs .nav-link').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('#contentTabsContent .tab-pane').forEach(pane => pane.classList.remove('show', 'active'));

            // Activate wisdom tab
            wisdomTab.classList.add('active');
            wisdomPane.classList.add('show', 'active');

            // Scroll to wisdom section
            wisdomPane.scrollIntoView({ behavior: 'smooth', block: 'start' });

            // Highlight the selected religion's card
            setTimeout(() => {
                const cards = document.querySelectorAll(`#${wisdomItem.id}Container .card`);
                cards.forEach(card => {
                    const badge = card.querySelector('.religion-badge');
                    if (badge && badge.textContent.toLowerCase().includes(religionName.toLowerCase().split(' ')[0])) {
                        card.style.transform = 'scale(1.03)';
                        card.style.boxShadow = '0 15px 40px rgba(0,0,0,0.2)';
                        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } else {
                        card.style.transform = '';
                        card.style.boxShadow = '';
                    }
                });
            }, 300);
        }
    </script>
</body>
</html>

