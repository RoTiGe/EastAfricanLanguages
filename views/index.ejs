    <!-- Schema.org structured data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Language Bridge",
        "url": "https://majelan.org",
        "description": "Free translation and language learning platform for 25 languages including European, Asian, Middle Eastern, and East African languages.",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Web",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "provider": {
            "@type": "Organization",
            "name": "Language Bridge",
            "url": "https://majelan.org"
        },
        "audience": {
            "@type": "Audience",
            "audienceType": "Language Learners, Refugees, East African Communities, Humanitarian Workers, Students, Travelers"
        },
        "inLanguage": ["en", "es", "fr", "de", "it", "zh", "ko", "hi", "bn", "te", "ar", "fa", "ku", "am", "om", "ti", "so", "sw", "rw", "rn", "lg", "luo", "dinka", "nuer"],
        "featureList": [
            "Translation between 25 languages across 4 continents",
            "Text-to-Speech audio pronunciation",
            "Interactive word matching games",
            "Contextual conversation learning",
            "Emergency phrase quick access",
            "Offline-capable translations"
        ]
    }
    </script>
    
