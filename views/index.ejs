            <!-- Quick Test Section -->
            <section class="quick-test p-4 rounded-3 shadow-sm mb-5">
                <h2 class="h3 mb-4 text-primary">
                    <i class="bi bi-lightning-charge me-2"></i>Quick Test
                </h2>
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label for="quickLanguage" class="form-label fw-semibold">Select Language</label>
                        <select id="quickLanguage" class="form-select form-select-lg">
                            <% languages.forEach(language => { %>
                            <option value="<%= language %>"><%= languageNames[language] || language %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-12 col-md-8">
                        <label for="quickText" class="form-label fw-semibold">Enter Text</label>
                        <textarea 
                            id="quickText" 
                            class="form-control form-control-lg" 
                            placeholder="Enter text to speak..."
                            rows="3"
                        >Hello! This is a test.</textarea>
                    </div>
                    <div class="col-12">
                        <button onclick="speakText()" class="btn btn-primary btn-lg">
                            <i class="bi bi-volume-up me-2"></i>Speak
                        </button>
                    </div>
                </div>

                <div id="status" class="status mt-3"></div>
                <audio id="audioPlayer" controls class="audio-player w-100 mt-3"></audio>
            </section>

