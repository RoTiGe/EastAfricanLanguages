<%# ── PWA / Android App Support ── %>
<%# Include this inside <head> on every page %>

<%# Web App Manifest (enables Add to Home Screen + standalone display) %>
<link rel="manifest" href="/manifest.json">

<%# Theme colour shown in Android system UI / Chrome address bar %>
<meta name="theme-color" content="#667eea">
<meta name="msapplication-TileColor" content="#667eea">

<%# Android Chrome — enables standalone (full-screen, no browser chrome) %>
<meta name="mobile-web-app-capable" content="yes">
<meta name="application-name" content="Language Bridge">

<%# iOS Safari — same full-screen behaviour when added to home screen %>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Language Bridge">
<link rel="apple-touch-icon" href="/icons/icon.svg">

<%# Prevent phone-number auto-detection (avoids layout shifts on Android) %>
<meta name="format-detection" content="telephone=no">

<%# App icon for home screen / task switcher %>
<link rel="icon" type="image/svg+xml" href="/icons/icon.svg">

<%# Viewport — viewport-fit=cover lets content fill notched screens %>
<%# Override the basic viewport meta that most pages already have %>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, minimum-scale=1.0, maximum-scale=5.0">

