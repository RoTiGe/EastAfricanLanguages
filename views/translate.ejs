<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/pwa-head') %>
    <title>Free Multi-Language Translation - Amharic, Tigrinya, Oromo & 25+ Languages | Language Bridge</title>
    <meta name="description" content="Free online translation tool supporting 25+ languages including Amharic, Tigrinya, Afaan Oromoo, Somali, Arabic, Hindi, Chinese, Spanish, French, and more. Native language pronunciation audio for every translation.">
    <meta name="keywords" content="free multi language translation, free translation tool, Tigrinya to English audio translation, Amharic translation online, free Afaan Oromoo translation, Somali language translation, native language pronunciation online, online translation with audio, East African language translation, Kinyarwanda Kirundi translation, Hadiyaa Gamo Wolayitta translation">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://majelan.org/translate">
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://majelan.org/translate">
    <meta property="og:title" content="Free Multi-Language Translation with Audio - Language Bridge">
    <meta property="og:description" content="Free translation tool for 25+ languages including underrepresented African languages. Hear native pronunciations in Amharic, Tigrinya, Oromo, Somali, and more.">
    <meta property="og:site_name" content="Language Bridge">
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="Free Multi-Language Translation with Native Audio - Language Bridge">
    <meta property="twitter:description" content="Translate across 25+ languages including Amharic, Tigrinya, Oromo, Somali, Arabic, Hindi, and more. Hear native audio pronunciation instantly.">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid p-0">
        <%- include('partials/navbar') %>
        <!-- Header -->
        <header class="text-white py-4 position-relative">
            <div class="container">
                <a href="/" class="btn btn-light position-absolute top-0 start-0 m-3">
                    <i class="bi bi-arrow-left me-2"></i>Back to Home
                </a>
                <h1 class="text-center display-5 fw-bold">
                    <i class="bi bi-translate me-2"></i>Translation Mode
                </h1>
                <p class="text-center lead">Communicate across languages in real-time</p>
            </div>
        </header>

        <!-- Main Content -->
        <main class="container my-4">
            <!-- Info Banner -->
            <div class="alert alert-info shadow-sm mb-4">
                <div class="d-flex align-items-start">
                    <i class="bi bi-info-circle-fill fs-3 me-3"></i>
                    <div>
                        <h4 class="alert-heading h6 mb-2">How Translation Mode Works</h4>
                        <p class="mb-0">
                            Select your native language (what you speak), the target language (who you want to communicate with),
                            choose a category and phrase in your language, then see and hear it in the target language.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Language Selection Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="h4 mb-4 text-primary">
                        <i class="bi bi-globe me-2"></i>Select Languages
                    </h3>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="sourceLanguage" class="form-label fw-bold">
                                <i class="bi bi-person-fill me-2"></i>Your Native Language
                            </label>
                            <select id="sourceLanguage" class="form-select form-select-lg">
                                <option value="">Choose your language...</option>
                                <% Object.keys(languageNames).filter(lang => !lang.includes('_phonetic')).forEach(lang => { %>
                                    <option value="<%= lang %>"><%= languageNames[lang] %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="targetLanguage" class="form-label fw-bold">
                                <i class="bi bi-person-badge-fill me-2"></i>Target Language to Learn
                            </label>
                            <select id="targetLanguage" class="form-select form-select-lg">
                                <option value="">Choose target language...</option>
                                <% Object.keys(languageNames).filter(lang => !lang.includes('_phonetic')).forEach(lang => { %>
                                    <option value="<%= lang %>"><%= languageNames[lang] %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Phrase Selection Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="h4 mb-4 text-primary">
                        <i class="bi bi-chat-square-text me-2"></i>Select Phrase
                    </h3>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label for="categorySelect" class="form-label fw-semibold">
                                <i class="bi bi-folder me-2"></i>Category
                            </label>
                            <select id="categorySelect" class="form-select form-select-lg" disabled>
                                <option value="">-- Choose a category --</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="phraseSelect" class="form-label fw-semibold">
                                <i class="bi bi-chat-left-text me-2"></i>Phrase
                            </label>
                            <select id="phraseSelect" class="form-select form-select-lg" disabled>
                                <option value="">-- Choose a phrase --</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button id="translateBtn" class="btn btn-outline-secondary btn-lg" disabled>
                            <i class="bi bi-arrow-clockwise me-2"></i>Re-translate
                        </button>
                        <small class="text-muted ms-3">
                            <i class="bi bi-info-circle me-1"></i>Translation happens automatically when you select a phrase
                        </small>
                    </div>
                </div>
            </div>

            <!-- Translation Results -->
            <div id="resultsSection" class="card shadow-sm" style="display: none;">
                <div class="card-body p-4">
                    <h3 class="h4 mb-4 text-success">
                        <i class="bi bi-check-circle-fill me-2"></i>Translation Result
                    </h3>
                    
                    <div class="row g-4">
                        <!-- Source Language -->
                        <div class="col-12 col-lg-6">
                            <div class="border rounded p-4 bg-light">
                                <h4 class="h5 mb-3 text-primary">
                                    <i class="bi bi-person-fill me-2"></i>
                                    <span id="sourceLangName">Your Language</span>
                                </h4>
                                <div class="mb-3">
                                    <div class="text-muted small mb-1">Phrase:</div>
                                    <div id="sourceText" class="fs-4 fw-semibold"></div>
                                </div>
                                <div class="mb-3">
                                    <div class="text-muted small mb-1">Phonetic:</div>
                                    <div id="sourcePhonetic" class="fs-6 font-monospace"></div>
                                </div>
                                <div>
                                    <div class="text-muted small mb-1">English:</div>
                                    <div id="sourceEnglish" class="fs-6"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Target Language -->
                        <div class="col-12 col-lg-6">
                            <div class="border rounded p-4 bg-success bg-opacity-10">
                                <h4 class="h5 mb-3 text-success">
                                    <i class="bi bi-person-badge-fill me-2"></i>
                                    <span id="targetLangName">Their Language</span>
                                </h4>
                                <div class="mb-3">
                                    <div class="text-muted small mb-1">Translation:</div>
                                    <div id="targetText" class="fs-3 fw-bold text-success"></div>
                                </div>
                                <div class="mb-3">
                                    <div class="text-muted small mb-1">Phonetic:</div>
                                    <div id="targetPhonetic" class="fs-6 font-monospace"></div>
                                </div>
                                <div class="mb-3">
                                    <button id="speakBtn" class="btn btn-success btn-lg w-100">
                                        <i class="bi bi-volume-up-fill me-2"></i>Play Audio
                                    </button>
                                </div>
                                <div id="audioStatus" class="status"></div>
                                <audio id="audioPlayer" controls class="audio-player w-100 mt-2" style="display: none;"></audio>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-dark text-white text-center py-4 mt-5">
            <div class="container">
                <p class="mb-0">
                    <i class="bi bi-translate me-2"></i>Real-time Translation Mode
                </p>
            </div>
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery (required for Select2) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/translate.js?v=2.1"></script>
    <script>
        // Initialize Select2 on language dropdowns
        $(document).ready(function() {
            $('#sourceLanguage').select2({
                width: '100%',
                placeholder: 'Choose your language...'
            }).on('select2:select', function() {
                // Trigger the native change event for translate.js
                this.dispatchEvent(new Event('change'));
            });
            $('#targetLanguage').select2({
                width: '100%',
                placeholder: 'Choose target language...'
            }).on('select2:select', function() {
                // Trigger the native change event for translate.js
                this.dispatchEvent(new Event('change'));
            });

            // Restore saved language preferences
            const savedNative = localStorage.getItem('nativeLanguage');
            const savedTarget = localStorage.getItem('targetLanguage');
            if (savedNative) {
                $('#sourceLanguage').val(savedNative).trigger('change');
            }
            if (savedTarget) {
                // Wait briefly so the source language categories finish loading first
                setTimeout(() => {
                    $('#targetLanguage').val(savedTarget).trigger('change');
                }, 600);
            }
        });
    </script>
</body>
</html>
